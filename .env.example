# Copy to .env.local and fill in. Never commit .env.local.

# Supabase. Local values come from `supabase start` (needs Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used by route handlers through src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The two fixed hostnames (ruling R15). Both point at the same deployment.
# *.localhost resolves to 127.0.0.1, so no /etc/hosts edit is needed in dev.
DASHBOARD_HOST=survey.localhost:3000
PUBLIC_HOST=s.localhost:3000

# Cloudflare Turnstile, registered for PUBLIC_HOST.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# L8: test secrets (1x, 2x, 3x) are refused in production; use them in dev and preview only.
# A non-Vercel production build (next start for e2e) may set TURNSTILE_ALLOW_TEST_SECRET=1 to allow them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret Vercel Cron sends to /api/cron/* on DASHBOARD_HOST.
CRON_SECRET=

# Read by supabase/config.toml for local Google sign in (not by the app).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Daily-salted HMAC key for hashing respondent IPs in the rate limiter (doc 02 section 5.2). Required in production.
RATE_LIMIT_SECRET=

# Key for sealing shared-report password cookies (doc 04 section 5.4). Required in production, at least 32 characters (I4: no fallback to the service role key). Generate with `openssl rand -base64 48`.
REPORT_SHARE_SECRET=

# Owner email used by admin maintenance statements (seed.sql comment). Read from env, never typed into a command.
PLATFORM_ADMIN_EMAIL=
